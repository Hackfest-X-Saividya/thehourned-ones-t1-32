# Cloudflare AI Worker Integration (Matches API Handoff Specifications)
EXTERNAL_WORKER_URL=https://lingering-cake-50cc.adeepag13.workers.dev
EXTERNAL_WORKER_TOKEN=your-deployed-worker-api-token-here

# Backward compatibility bindings
CLOUDFLARE_WORKER_URL=https://lingering-cake-50cc.adeepag13.workers.dev
CLOUDFLARE_WORKER_TOKEN=your-deployed-worker-api-token-here

ENVIRONMENT=development
MOCK_AI=true
JWT_SECRET=replace-with-a-random-secret
MAX_FILE_SIZE_BYTES=10485760
DEFAULT_IMAGE_WIDTH=1024
DEFAULT_IMAGE_HEIGHT=1024

# Gemini 3.5 Live Preview Multilingual Translation Model
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-live-preview
