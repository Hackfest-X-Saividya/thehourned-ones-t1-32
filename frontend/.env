# Centralized API service target (routed via Vite proxy to Cloudflare Workers backend at http://127.0.0.1:8787)
VITE_API_BASE_URL=/api

# Live Backend Worker API Integration
# Set to 'false' to route all candidate generation, selection, and inpainting to the live Cloudflare Worker API
# Set to 'true' for offline SVG fallback simulation
VITE_USE_MOCK_DATA=false

VITE_APP_TITLE=CHITRAGUPTA Forensic Sketch Suite
VITE_ORGANIZATION_NAME=Cyber & Forensic Crime Cell
VITE_DEPLOYMENT_ENV=development

# Gemini 3.5 Live Preview Multilingual Model
VITE_GEMINI_MODEL=gemini-3.5-live-preview
VITE_GEMINI_API_KEY=
